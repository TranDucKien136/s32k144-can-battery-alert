	(text "NODE 1: sensor board (BOARD_NUMBER = 1)\nJ1 = MaaZ S32K144 header J8\n1 = J8-22  3V3\n2 = J8-18  PTC14 sensor DO\n3 = J8-24  GND"
		(exclude_from_sim no)
		(at 40.64 71.12 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ceda8023-ec22-4625-ad81-6835b4e463c0")
	)
	(text "J2: NTC module (NTC 10k + LM393)\npins DO, GND, VCC (no AO pin)\nDO = 0 when over threshold\npowered from 3.3 V so DO <= 3.3 V"
		(exclude_from_sim no)
		(at 213.36 71.12 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "785ca4a8-366c-42ed-8c30-3ae23723f047")
	)
	(text "NODE 2: display board (BOARD_NUMBER = 2)\nJ6 = MaaZ S32K144 header J8\n1 = J8-01  5V\n2 = J8-10  PTA3 SCL\n3 = J8-12  PTA2 SDA\n4 = J8-24  GND"
		(exclude_from_sim no)
		(at 40.64 115.57 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "7b18e011-cfc6-4840-90e7-45f1d3cc29e4")
	)
	(text "J5: LCD 1602 + PCF8574 I2C backpack\nI2C address 0x27 (or 0x3F), 5 V\nheader order: GND, VCC, SDA, SCL\nno level shifter in this build"
		(exclude_from_sim no)
		(at 213.36 115.57 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "97201136-b4d9-4e5f-b3fe-a097cada6e98")
	)
	(text "CAN bus 500 kbit/s: CANH-CANH, CANL-CANL (not crossed)\nJ3/J4 = header J13, on-board transceiver (FlexCAN0 PTE4 RX / PTE5 TX)\neach board: split 120 Ω termination (R47 + R48 + C32), bus ≈ 60 Ω\nframe ID 0x101 every 0.5 s, node 2 link-loss timeout 2 s"
		(exclude_from_sim no)
		(at 128.27 104.14 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "157da329-4fcf-40ee-81c6-4aabc8d1c0b0")
	)
